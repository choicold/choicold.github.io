---
interface Props {
	project: {
		description: string;
		stack: string[];
		team: string;
		role: string;
	};
}
const { project } = Astro.props;
---

<div class="mt-3 grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-6">
	<div class="min-w-0">
		<p class="text-muted">{project.description}</p>
		<ul class="mt-3 flex flex-wrap gap-1.5">
			{
				project.stack.map((technology) => (
					<li class="border-accent-2/15 text-muted rounded-md border px-2 py-0.5 text-xs">
						{technology}
					</li>
				))
			}
		</ul>
	</div>
	<dl class="grid grid-cols-[auto_auto] content-start gap-x-6 text-sm">
		<div>
			<dt class="text-muted text-xs">팀 규모</dt>
			<dd class="text-accent-2 mt-1 font-semibold">{project.team}</dd>
		</div>
		<div>
			<dt class="text-muted text-xs">담당 역할</dt>
			<dd class="text-accent-2 mt-1 font-semibold">{project.role}</dd>
		</div>
	</dl>
</div>
