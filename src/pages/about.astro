---
import { Icon } from "astro-icon/components";
import CVEntry from "@/components/cv/CVEntry.astro";
import CVSection from "@/components/cv/CVSection.astro";
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "백엔드 엔지니어링을 지향하는 학생 개발자 최한기의 이력 소개",
	title: "CV",
};

const skillGroups: { items: string[]; label: string }[] = [
	{
		label: "Back-End",
		items: ["Java", "Spring Boot", "Spring Data JPA", "PostgreSQL", "Flyway"],
	},
	{
		label: "DevOps",
		items: ["AWS (EC2, RDS)", "Docker", "Docker Compose", "GitHub Actions"],
	},
];

const awards: {
	org: string;
	paper?: { title: string; url: string };
	photo?: { alt: string; src: string };
	suffix?: string;
	title: string;
}[] = [
	{
		title: "ASK 2025 학부생 논문경진대회 / 금상 (2025)",
		org: "한국정보처리학회",
		paper: {
			title: "AutomationElement 기반 UI 상호작용을 통한 사용자 패턴 분석 시스템",
			url: "/papers/KIPS_C2025A0200F.pdf",
		},
		photo: { alt: "ASK 2025 학부생 논문경진대회 금상 수상 사진", src: "/awards/ask2025-gold.jpeg" },
	},
	{
		title: "UNITHON 2025 / 최우수상 (2025)",
		org: "교내 연합 해커톤",
		suffix: "JIRA Chrome Extension 개발",
		photo: { alt: "UNITHON 2025 최우수상 수상 사진", src: "/awards/unithon2025.jpeg" },
	},
];
---

<PageLayout meta={meta}>
	<div class="mb-4 flex justify-end print:hidden">
		<button
			type="button"
			id="cv-print"
			class="border-accent-2/30 text-muted hover:text-link inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs"
		>
			<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:file-pdf-box" />
			PDF로 저장
		</button>
	</div>

	<div id="cv-document">
	<header class="mb-4 flex flex-wrap items-end justify-between gap-4">
		<div>
			<h1 class="title mb-1">최한기</h1>
			<p class="text-muted">Software Engineer · Backend Developer</p>
		</div>
		<SocialList showLabel={false} />
	</header>

	<CVSection title="Introduce">
		<div class="prose prose-sm prose-cactus max-w-none">
			<p>
				안녕하세요, 추측보다는 데이터를 기반으로 한 판단을 중시하는 개발자
				<strong>최한기</strong>입니다.
			</p>
			<p>
				백엔드 엔지니어링과 데이터베이스 설계에 관심이 많으며, 문제를 해결할 때 지표를 먼저
				측정하고 그 결과를 근거로 의사결정을 내리는 방식을 지향합니다. 뉴스 검색 쿼리의 병목을
				측정해 인덱스 전환으로 실행 속도를 약 37배 단축하거나, 마스터 데이터 커버리지를
				수치로 검증해 불필요한 LLM 파이프라인 도입을 기각하는 등 측정 기반의 선택을 쌓아가고
				있습니다.
			</p>
		</div>
	</CVSection>

	<CVSection title="Skills">
		<div class="space-y-4">
			{
				skillGroups.map((group) => (
					<div>
						<h3 class="text-accent-2 mb-2 text-base font-semibold">{group.label}</h3>
						<ul class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<li class="border-accent-2/15 text-muted rounded-md border px-2.5 py-1 text-xs">
									{item}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</CVSection>

	<CVSection title="Projects">
		<CVEntry
			title="Brief"
			storeUrl="https://play.google.com/store/apps/details?id=com.swyp.brife&hl="
			repoUrl="https://github.com/swyp-app-4/Brief"
			subtitle="네이버 뉴스 스크래핑 및 LLM 프롬프팅을 활용한 관심사 기반 카테고리별 통합 요약 앱"
			period="2026.02 ~ 2026.04"
			tags={["spring-boot", "postgresql", "jpa", "llm", "openapi"]}
		>
			<ul>
				<li>
					<strong>[성능 개선]</strong> 뉴스 검색 쿼리의 Seq Scan 문제를 pg_trgm GIN 인덱스로
					전환하여 외부 검색엔진 도입 없이 실행 속도를 93ms에서 2.5ms로 약 37배 단축
				</li>
				<li>
					<strong>[쿼리 최적화]</strong> 검색 결과 조회 시 Slice로 count 쿼리를 회피하고,
					카테고리 균형 홈피드는 Window Function을 활용해 단일 쿼리로 최적화
				</li>
				<li>
					<strong>[DB 재설계]</strong> 온보딩 선택·파이프라인 입력·Topic 부모 3가지 책임이
					혼재된 단일 Category 테이블을 category_group과 category로 분리하여 FK 정합성 확보 및
					도메인 결합도 감소
				</li>
				<li>
					<strong>[협업 방식]</strong> OpenAPI 3.0 명세 기반의 API 설계로 프론트엔드와 협업
				</li>
			</ul>
		</CVEntry>

		<CVEntry
			title="KeepEat"
			repoUrl="https://github.com/KeepEatSSU/KeepEat/tree/BE"
			subtitle="1인 가구를 위한 식재료 소비기한·재고 관리 및 보유 식재료 기반 AI 맞춤 레시피 추천 앱"
			period="2026.03 ~ 진행 중"
			tags={["spring-boot", "postgresql", "aws", "docker", "github-actions", "llm"]}
		>
			<ul>
				<li>
					<strong>[도메인 모델링]</strong> 가정 식재료 도메인을 10개 대분류·49개 중분류·611개
					품목으로 체계화하고, JSON 기반 보관 기간 스키마를 설계하여 소비기한 계산 로직 일반화
				</li>
				<li>
					<strong>[데이터 기반 의사결정]</strong> 마켓컬리·이마트몰 210개 상품 샘플링으로 자체
					마스터 식재료 DB의 시중 데이터 커버리지가 82%임을 측정, 이를 근거로 미등록 식재료의
					LLM 자동분류 파이프라인 도입을 기각하고 사용자 커스텀 등록으로 우회하여 데이터 무결성
					확보
				</li>
				<li>
					<strong>[AI 도구 활용]</strong> Claude Code 기반 AI 협업 환경을 설정 — agent·skills
					정의와 컨벤션 문서를 정리해 AI 생성 코드의 일관성을 확보하고, 사람이 직접 검증하는
					단계를 두어 통제
				</li>
				<li>
					<strong>[인프라 구축]</strong> AWS EC2·RDS 기반 서버 아키텍처 설계 및 배포를 완료하고,
					GitHub Actions를 연동하여 CI/CD 파이프라인 구축
				</li>
			</ul>
		</CVEntry>
	</CVSection>

	<CVSection title="Education">
		<CVEntry
			title="숭실대학교 소프트웨어학부 학사 (졸업예정)"
			period="2021.03 ~ 2027.02"
		>
			<ul>
				<li>GPA 3.6 / 4.5</li>
			</ul>
		</CVEntry>
	</CVSection>

	<CVSection title="ETC">
		<div class="space-y-4">
			{
				awards.map((award) => (
					<div>
						<p class="text-accent-2 text-sm font-semibold">
							{award.photo ? (
								<button
									type="button"
									class="cactus-link cursor-pointer text-left"
									data-award-photo={award.photo.src}
									data-award-alt={award.photo.alt}
								>
									{award.title}
								</button>
							) : (
								award.title
							)}
						</p>
						<p class="text-muted mt-1 text-sm">
							{award.org}
							{" — "}
							{award.paper ? (
								<a class="cactus-link" href={award.paper.url} rel="noreferrer" target="_blank">
									"{award.paper.title}"
								</a>
							) : (
								award.suffix
							)}
						</p>
					</div>
				))
			}
		</div>
	</CVSection>
	</div>

	{/* Lightbox for award photos */}
	<dialog
		id="award-lightbox"
		class="bg-global-bg/95 m-0 h-full max-h-full w-full max-w-full backdrop:bg-black/70"
	>
		<button
			type="button"
			id="award-lightbox-x"
			class="text-global-text hover:text-link absolute top-4 right-4 z-10 cursor-pointer rounded-full border border-current/30 p-2 leading-none"
			aria-label="닫기"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="h-5 w-5"
				aria-hidden="true"
			>
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
		<button
			type="button"
			id="award-lightbox-close"
			class="flex h-full w-full cursor-zoom-out items-center justify-center p-4"
			aria-label="닫기"
		>
			<img id="award-lightbox-img" class="max-h-[90vh] max-w-full object-contain" src="" alt="" />
		</button>
	</dialog>
</PageLayout>

<style>
	@media print {
		/* 네비게이션 헤더, 푸터 등 CV 외 요소 숨김 */
		:global(#main-header),
		:global(footer) {
			display: none !important;
		}

		/* 본문 여백/너비 초기화 → 인쇄 페이지를 꽉 채우도록 */
		:global(body) {
			max-width: none !important;
			padding-top: 0 !important;
			background: #fff !important;
			color: #000 !important;
		}

		:global(main) {
			margin: 0 !important;
		}

		/* 라이트박스 다이얼로그는 인쇄에서 제외 */
		#award-lightbox {
			display: none !important;
		}

		/* PDF 저장 버튼은 인쇄물에서 제외 (print:hidden 에만 의존하지 않음) */
		#cv-print {
			display: none !important;
		}

		/* 개별 이력 항목(CVEntry)만 페이지 중간에서 쪼개지지 않게 — 섹션 전체엔 avoid 금지
		   (한 페이지보다 큰 섹션에 avoid를 걸면 통째로 다음 페이지로 밀려 거대 공백 발생) */
		:global(article) {
			break-inside: avoid;
		}

		/* 섹션 제목(h2)이 페이지 하단에 혼자 남지 않게 */
		:global(section > h2) {
			break-after: avoid;
		}

		/* PDF 제출용 — 색은 잉크 절약을 위해 검정 유지하되, 논문·repo 링크가
		   링크임을 알 수 있게 밑줄은 유지 */
		:global(a) {
			color: #000 !important;
			text-decoration: underline !important;
		}
	}

	@page {
		margin: 16mm;
	}
</style>

<script>
	const printBtn = document.getElementById("cv-print");
	printBtn?.addEventListener("click", () => window.print());

	const dialog = document.getElementById("award-lightbox") as HTMLDialogElement | null;
	const img = document.getElementById("award-lightbox-img") as HTMLImageElement | null;
	const closeBtn = document.getElementById("award-lightbox-close");
	const xBtn = document.getElementById("award-lightbox-x");

	if (dialog && img) {
		for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-award-photo]")) {
			btn.addEventListener("click", () => {
				img.src = btn.dataset.awardPhoto ?? "";
				img.alt = btn.dataset.awardAlt ?? "";
				dialog.showModal();
			});
		}
		closeBtn?.addEventListener("click", () => dialog.close());
		xBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			dialog.close();
		});
		// Click on the backdrop closes too (clicks on the img bubble to the close button)
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) dialog.close();
		});
	}
</script>
