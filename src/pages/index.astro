---
import CVEntry from "@/components/cv/CVEntry.astro";
import CVSection from "@/components/cv/CVSection.astro";
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "백엔드 엔지니어링을 지향하는 학생 개발자 최한기의 이력 소개",
	title: "CV",
};

const skillGroups: { items: string[]; label: string }[] = [
	{
		label: "Backend",
		items: ["Java", "TypeScript", "Spring Boot", "Spring Data JPA", "Node.js", "NestJS"],
	},
	{
		label: "Infrastructure",
		items: ["PostgreSQL", "MySQL", "Redis", "AWS EC2", "AWS RDS", "AWS S3", "Docker", "MinIO"],
	},
];

const awards: {
	org: string;
	paper?: { title: string; url: string };
	photo?: { alt: string; src: string };
	suffix?: string;
	title: string;
}[] = [
	{
		title: "제16회 숭실 캡스톤디자인 경진대회 / 장려상 (2026)",
		org: "숭실대학교",
		suffix: "식재료 소비기한 관리와 AI 맞춤 레시피를 추천하는 서비스 KeepEat 개발",
	},
	{
		title: "HMG 소프티어 8기 / 소프티어 챌린지 상 (2026)",
		org: "현대자동차그룹 ICT본부",
		suffix: "흩어진 여행 콘텐츠를 지도에 모아 함께 저장하는 서비스 mapin 개발",
	},
	{
		title: "ASK 2025 학부생 논문경진대회 / 금상 (2025)",
		org: "한국정보처리학회",
		paper: {
			title: "AutomationElement 기반 UI 상호작용을 통한 사용자 패턴 분석 시스템",
			url: "/papers/KIPS_C2025A0200F.pdf",
		},
		photo: { alt: "ASK 2025 학부생 논문경진대회 금상 수상 사진", src: "/awards/ask2025-gold.jpeg" },
	},
	{
		title: "UNITHON 2025 / 최우수상 (2025)",
		org: "교내 연합 해커톤",
		suffix: "JIRA Chrome Extension 개발",
		photo: { alt: "UNITHON 2025 최우수상 수상 사진", src: "/awards/unithon2025.jpeg" },
	},
];
---

<PageLayout meta={meta}>
	<div class="relative print:hidden">
		<button
			type="button"
			id="cv-print"
			class="absolute right-0 bottom-2 z-10 rounded-md px-3 py-1.5 text-xs opacity-0"
		>
			PDF로 저장
		</button>
	</div>

	<div id="cv-document">
		<header class="relative mb-4 pr-28">
			<div>
				<div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1">
					<h1 class="title">최한기</h1>
					<SocialList showLabel={false} />
				</div>
				<p class="text-muted">Backend Developer</p>
			</div>
			<img
				src="/face.jpg"
				alt="최한기 프로필 사진"
				class="absolute top-0 right-0 h-28 w-24 rounded-md object-cover"
			/>
		</header>

		<CVSection title="Introduce">
			<div class="prose prose-sm prose-cactus max-w-none">
				<p>
					서비스의 핵심 요구를 기준으로 데이터를 검증하고, 구현 비용과 운영 부담을 고려해 해결
					범위를 정하는 백엔드 개발자 <strong>최한기</strong>입니다.
				</p>
			</div>
		</CVSection>

		<CVSection title="Projects">
			<CVEntry
				title="Brief"
				storeUrl="https://play.google.com/store/apps/details?id=com.swyp.brife&hl="
				repoUrl="https://github.com/swyp-app-4/Brief"
				subtitle="네이버에 게재된 여러 언론사의 기사를 관심사와 카테고리별로 통합 요약하는 앱"
				period="2026.02 ~ 2026.04"
			>
				<ul>
					<li>
						뉴스 약 1.6만 건에서 pg_trgm GIN 인덱스를 적용해 검색 실행 시간을
						<strong>93ms에서 2.5ms로 단축</strong>
					</li>
					<li>
						Window Function을 적용해 <strong>홈피드 조회를 단일 쿼리로 통합</strong>
					</li>
				</ul>
			</CVEntry>

			<CVEntry
				title="KeepEat"
				repoUrl="https://github.com/KeepEatSSU/KeepEat/tree/BE"
				subtitle="냉장고 속 식재료를 관리하고 보유 식재료로 요리할 레시피를 추천하는 앱"
				period="2026.03 ~ 2026.06"
			>
				<ul>
					<li>
						약 36만 개 레시피의 식재료명을 바탕으로 <strong
							>611개 품목의 식재료 마스터 DB 설계</strong
						>
					</li>
					<li>
						컬리와 SSG 상품 450개에서 마스터 DB 커버리지 82%를 확인하고, 미포함 약 18%가 밀키트와
						완제품 등 서비스 대상 밖의 식료품임을 분석해
						<strong>미등록 식재료의 소비기한 제공을 위한 LLM 자동화 도입 보류</strong>. 예외는
						사용자 커스텀 등록으로 수용하고 마스터 DB 반영은 관리자 검토로 처리하는 방안 선택
					</li>
					<li>
						AWS EC2와 RDS로 서버를 배포하고 GitHub Actions로 <strong>배포 자동화 구축</strong>
					</li>
				</ul>
			</CVEntry>
		</CVSection>

		<CVSection title="Experience">
			<CVEntry title="이모션웨이브" inlineSubtitle="인턴" period="2026.09 ~ 현재">
				<ul>
					<li>AI Agent 개발</li>
				</ul>
			</CVEntry>
			<CVEntry title="HMG SOFTEER BOOTCAMP 8기" period="2026.07 ~ 2026.08">
				<ul>
					<li>웹 백엔드 과정</li>
				</ul>
			</CVEntry>
		</CVSection>

		<CVSection title="Skills">
			<div class="space-y-8">
				{
					skillGroups.map((group) => (
						<div>
							<h3 class="text-accent-2 mb-1.5 text-base font-semibold">{group.label}</h3>
							<ul class="flex flex-wrap gap-1.5">
								{group.items.map((item) => (
									<li class="border-accent-2/15 text-muted rounded-md border px-2 py-0.5 text-xs">
										{item}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</CVSection>

		<CVSection title="Education">
			<CVEntry title="숭실대학교 소프트웨어학부 학사 (졸업예정)" period="2021.03 ~ 2027.02">
				<ul>
					<li>GPA 3.73 / 4.5</li>
				</ul>
			</CVEntry>
		</CVSection>

		<CVSection title="Awards">
			<div class="space-y-4">
				{
					awards.map((award) => (
						<div>
							<p class="text-accent-2 text-sm font-semibold">
								{award.photo ? (
									<a
										class="cactus-link cursor-pointer text-left"
										href={award.photo.src}
										data-award-photo={award.photo.src}
										data-award-alt={award.photo.alt}
										rel="noreferrer"
										target="_blank"
									>
										{award.title}
									</a>
								) : (
									award.title
								)}
							</p>
							<p class="text-muted mt-1 text-sm">
								{award.org}
								{(award.paper || award.suffix) && " — "}
								{award.paper ? (
									<a class="cactus-link" href={award.paper.url} rel="noreferrer" target="_blank">
										"{award.paper.title}"
									</a>
								) : (
									award.suffix
								)}
							</p>
						</div>
					))
				}
			</div>
		</CVSection>
	</div>

	{/* Lightbox for award photos */}
	<dialog
		id="award-lightbox"
		class="bg-global-bg/95 m-0 h-full max-h-full w-full max-w-full backdrop:bg-black/70"
	>
		<button
			type="button"
			id="award-lightbox-x"
			class="text-global-text hover:text-link absolute top-4 right-4 z-10 cursor-pointer rounded-full border border-current/30 p-2 leading-none"
			aria-label="닫기"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="h-5 w-5"
				aria-hidden="true"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
		<button
			type="button"
			id="award-lightbox-close"
			class="flex h-full w-full cursor-zoom-out items-center justify-center p-4"
			aria-label="닫기"
		>
			<img id="award-lightbox-img" class="max-h-[90vh] max-w-full object-contain" src="" alt="" />
		</button>
	</dialog>
</PageLayout>

<style>
	#cv-document {
		word-break: keep-all;
		overflow-wrap: anywhere;
	}

	@media print {
		/* 네비게이션 헤더, 푸터 등 CV 외 요소 숨김 */
		:global(#main-header),
		:global(footer) {
			display: none !important;
		}

		/* 본문 여백/너비 초기화 → 인쇄 페이지를 꽉 채우도록 */
		:global(body) {
			max-width: none !important;
			padding-top: 0 !important;
			background: #fff !important;
			color: #000 !important;
		}

		:global(main) {
			margin: 0 !important;
		}

		/* 라이트박스 다이얼로그는 인쇄에서 제외 */
		#award-lightbox {
			display: none !important;
		}

		/* 개별 이력 항목(CVEntry)만 페이지 중간에서 쪼개지지 않게 — 섹션 전체엔 avoid 금지
		   (한 페이지보다 큰 섹션에 avoid를 걸면 통째로 다음 페이지로 밀려 거대 공백 발생) */
		:global(article) {
			break-inside: avoid;
		}

		/* 섹션 제목(h2)이 페이지 하단에 혼자 남지 않게 */
		:global(section > h2) {
			break-after: avoid;
		}

		/* PDF 제출용 — 색은 잉크 절약을 위해 검정 유지하되, 논문·repo 링크가
		   링크임을 알 수 있게 밑줄은 유지 */
		:global(a) {
			color: #000 !important;
			text-decoration: underline !important;
		}
	}

	@page {
		margin: 16mm;
	}
</style>

<script>
	const printBtn = document.getElementById("cv-print");
	printBtn?.addEventListener("click", () => window.print());

	const dialog = document.getElementById("award-lightbox") as HTMLDialogElement | null;
	const img = document.getElementById("award-lightbox-img") as HTMLImageElement | null;
	const closeBtn = document.getElementById("award-lightbox-close");
	const xBtn = document.getElementById("award-lightbox-x");

	if (dialog && img) {
		for (const btn of document.querySelectorAll<HTMLAnchorElement>("[data-award-photo]")) {
			btn.addEventListener("click", (e) => {
				// 화면에서는 라이트박스로 띄움. PDF(JS 미작동)에서는 href가 그대로 작동해
				// 사진 URL로 이동 → 논문 링크와 동일하게 클릭 가능
				e.preventDefault();
				img.src = btn.dataset.awardPhoto ?? "";
				img.alt = btn.dataset.awardAlt ?? "";
				dialog.showModal();
			});
		}
		closeBtn?.addEventListener("click", () => dialog.close());
		xBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			dialog.close();
		});
		// Click on the backdrop closes too (clicks on the img bubble to the close button)
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) dialog.close();
		});
	}
</script>
