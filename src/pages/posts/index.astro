---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import Base from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const posts = (await getAllPosts()).sort(collectionDateSort);
const tags = getUniqueTagsWithCount(posts);
---

<Base meta={{ title: "Posts", description: "경험을 돌아보는 회고와 공부한 기술을 정리하는 글" }}>
	<div class="document-grid">
		<section>
			<header class="page-heading">
				<h1 class="title">Posts</h1>
			</header>
			<div class="post-filters" role="group" aria-label="글 분류">
				{
					["전체", "회고", "기술"].map((category) => (
						<button
							type="button"
							data-category-filter={category}
							aria-pressed={category === "전체"}
						>
							{category}
						</button>
					))
				}
			</div>
			<div class="post-list">
				{
					posts.map((post) => (
						<article data-post-category={post.data.category}>
							<>
								<time datetime={post.data.publishDate.toISOString()}>
									{post.data.publishDate.toLocaleDateString("ko-KR", {
										year: "numeric",
										month: "2-digit",
										day: "2-digit",
										timeZone: "Asia/Seoul",
									})}
								</time>
								<div>
									<>
										<h2>
											<a href={`/posts/${post.id}/`}>{post.data.title}</a>
										</h2>
										{post.data.draft && <span>초안</span>}
									</>
								</div>
							</>
						</article>
					))
				}
			</div>
			<p id="empty-category" hidden class="page-description">아직 작성된 글이 없습니다.</p>
		</section><aside class="index-aside">
			<h2>Tags</h2><ul>
				{
					tags.map(([tag, count]) => (
						<li>
							<a href={`/tags/${tag}/`}>
								{tag}
								<span>{count}</span>
							</a>
						</li>
					))
				}
			</ul><a href="/tags/">View all →</a><br/><a href="/rss.xml">RSS feed</a>
		</aside>
	</div>
</Base>
<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
	const posts = [...document.querySelectorAll<HTMLElement>("[data-post-category]")];
	for (const button of buttons)
		button.addEventListener("click", () => {
			let visible = 0;
			for (const item of buttons) item.setAttribute("aria-pressed", String(item === button));
			for (const post of posts) {
				post.hidden =
					button.dataset.categoryFilter !== "전체" &&
					post.dataset.postCategory !== button.dataset.categoryFilter;
				if (!post.hidden) visible++;
			}
			const empty = document.getElementById("empty-category");
			if (empty) empty.hidden = visible > 0;
		});
</script>
