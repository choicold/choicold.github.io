---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import TOC from "@/components/blog/TOC.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getCategory } from "@/data/wiki";
import WikiLayout from "@/layouts/Wiki.astro";

export const getStaticPaths = (async () => {
	const all = await getCollection("wiki");
	return all.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const category = getCategory(entry);
const displayDate = entry.data.updatedDate ?? entry.data.publishDate;

const meta = {
	description: entry.data.description || `${category} — ${entry.data.title}`,
	title: entry.data.title,
};
---

<WikiLayout meta={meta}>
	<article data-pagefind-body>
		<nav aria-label="Breadcrumb" class="text-muted mb-4 text-xs">
			<a class="hover:text-link" href="/wiki/">Wiki</a>
			<span aria-hidden="true"> / </span>
			<span>{category}</span>
		</nav>

		<h1 class="title mb-2">{entry.data.title}</h1>

		{
			displayDate && (
				<p class="text-muted mb-6 text-xs">
					{entry.data.updatedDate ? "갱신 " : ""}
					<FormattedDate
						date={displayDate}
						dateTimeOptions={{ year: "numeric", month: "short", day: "numeric" }}
					/>
				</p>
			)
		}

		<div class="document-grid wiki-body">
			{headings.length > 0 && <TOC headings={headings} />}
			<div class="prose reading-content">
				<Content />
			</div>
		</div>
	</article>
</WikiLayout>
